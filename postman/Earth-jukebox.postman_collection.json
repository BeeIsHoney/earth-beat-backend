{
  "info": {
    "name": "Earth Jukebox — Temperature / Rainfall / Vegetation",
    "description": "Signal measurement မှ JSON frames / WAV အသံ စမ်းရန်။ rainfall / NDVI values များကို ကိုယ့် dataset မှပေးရပါမယ်။ ဥပမာ values များက test data သာဖြစ်ပါတယ်။",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "year",
      "value": "2024",
      "type": "string"
    },
    {
      "key": "month",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "တစ်လစာ temperature နဲ့ pitch",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/temperature?year={{year}}&month={{month}}"
      },
      "response": []
    },
    {
      "name": "တစ်နှစ်စာ frames",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/temperature?year={{year}}"
      },
      "response": []
    },
    {
      "name": "နှစ်စာရင်း",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/temperature/years"
      },
      "response": []
    },
    {
      "name": "နောက်ဆုံးလ",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/temperature/latest"
      },
      "response": []
    },
    {
      "name": "NASA dataset metadata",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/dataset"
      },
      "response": []
    },
    {
      "name": "Temperature — NASA year WAV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/temperature/audio?year={{year}}"
      },
      "response": []
    },
    {
      "name": "Temperature — manual anomaly WAV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/sound/audio?signal=temperature&value=1.25"
      },
      "response": []
    },
    {
      "name": "Rainfall — JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/rainfall?rainfallMm=20"
      },
      "response": []
    },
    {
      "name": "Rainfall — WAV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/rainfall/audio?rainfallMm=20"
      },
      "response": []
    },
    {
      "name": "Vegetation — JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/vegetation?ndvi=0.7"
      },
      "response": []
    },
    {
      "name": "Vegetation — WAV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/earth/vegetation/audio?ndvi=0.7"
      },
      "response": []
    },
    {
      "name": "Rainfall timeline — WAV (Send and Download)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/sound/audio",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signal\": \"rainfall\",\n  \"values\": [\n    0,\n    5,\n    15,\n    30,\n    60,\n    100,\n    60,\n    30,\n    15,\n    5,\n    0\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Vegetation timeline — WAV (Send and Download)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/sound/audio",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signal\": \"vegetation\",\n  \"values\": [\n    0.1,\n    0.2,\n    0.35,\n    0.5,\n    0.7,\n    0.9,\n    0.7,\n    0.5,\n    0.3,\n    0.1\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Temperature timeline — WAV (Send and Download)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/sound/audio",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signal\": \"temperature\",\n  \"values\": [\n    -0.6,\n    -0.2,\n    0.2,\n    0.5,\n    0.8,\n    1.1,\n    1.3,\n    1.6\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Rainfall timeline — JSON frames",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/earth/sound/frames",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"signal\": \"rainfall\",\n  \"values\": [\n    0,\n    10,\n    30\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
